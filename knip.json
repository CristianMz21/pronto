{
  "$schema": "https://unpkg.com/knip@5.63.1/schema.json",
  "entry": [
    "app/**/page.tsx!",
    "app/**/layout.tsx!",
    "app/**/route.ts!",
    "app/sw.ts!",
    "app/**/*.tsx!",
    "app/**/*.ts!",
    "lib/**/*.ts!",
    "components/**/*.tsx!",
    "hooks/**/*.ts!",
    "scripts/**/*.js!",
    "scripts/*.js!",
    "src/**/*.ts!"
  ],
  "project": ["**/*.{js,ts,jsx,tsx,css}"],
  "ignore": ["drizzle/relations.ts", "tests/e2e/fixtures/**", "tests/e2e/helpers/**"],
  "ignoreDependencies": ["@swc/helpers", "tailwindcss-animate!"],
  "ignoreBinaries": ["supabase"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "off"
  }
}
