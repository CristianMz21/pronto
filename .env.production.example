# =================================================================
# Pronto / Escudería — PRODUCTION env template (selfhosted)
# Copiá este archivo a .env en tu VPS / producción y reemplazá <...> placeholders.
# NUNCA commitees valores reales. Generá secrets con: openssl rand -hex 32
# Ver docs/production-runbook.md §8 + §11 (BLOCKED external) para go-live.
# =================================================================

# ── Deployment mode ───────────────────────────────────────────────
# Hardcodeado a selfhosted en docker-compose.yml (environment: NEXT_PUBLIC_DEPLOYMENT_MODE=selfhosted)
# Se mantiene aquí como documentación; docker-compose.yml lo sobreescribe si está en .env.
NEXT_PUBLIC_DEPLOYMENT_MODE=selfhosted

# ── Supabase Cloud ────────────────────────────────────────────────
# Dashboard → Project Settings → General (Project ref = <ref>) + API (anon/service_role) + Database → Connection string
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon>
SUPABASE_SERVICE_ROLE_KEY=<service_role>
# Direct connection (5432), NO pooler (6543), con SSL requerido en Cloud
DATABASE_URL=postgresql://postgres.<ref>:<pass>@db.<ref>.supabase.co:5432/postgres?sslmode=require

# ── Dominio ───────────────────────────────────────────────────────
# Reemplazá <APP_DOMAIN> por tu dominio real (ej: <APP_DOMAIN> sin https ni www)
APP_DOMAIN=<APP_DOMAIN>
NEXT_PUBLIC_APP_URL=https://<APP_DOMAIN>
NEXT_PUBLIC_SITE_URL=https://<APP_DOMAIN>

# ── Secrets — genera con: openssl rand -hex 32 ───────────────────
CRON_SECRET=<openssl rand -hex 32>
INTERNAL_API_SECRET=<openssl rand -hex 32>

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_<...>
RESEND_FROM_EMAIL=Pronto <noreply@<APP_DOMAIN>>
