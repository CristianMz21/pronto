{
  "name": "pronto",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "sh -c 'next build'",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx drizzle/seed.ts",
    "db:seed:realistic": "psql \"$DATABASE_URL\" -f supabase/seed-realistic.sql",
    "db:seed:realistic:local": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -f supabase/seed-realistic.sql",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write ./",
    "format:check": "biome format ./",
    "lint:biome": "biome lint ./ || true",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@swc/helpers": "^0.5.21",
    "autoprefixer": "^10.4.27",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "^3.14.0",
    "lucide-react": "^0.453.0",
    "next": "16.3.2",
    "next-intl": "^4.9.0",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^4.0.0",
    "rrule": "^2.8.1",
    "serwist": "^9.5.12",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.33.0",
    "lint-staged": "^17.4.1",
    "pg": "^8.22.0",
    "postcss": "^8",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "biome format --write --no-errors-on-unmatched"
    ],
    "*.{json,md,css}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "^0.25.12"
  }
}
